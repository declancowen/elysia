# Optional Elysia environment configuration.
# Elysia Connect is disabled in this fork. Do not configure another product's
# identity provider or relay. Configure your own services before enabling it.
# Do not add server-side secrets to this file.

# These legacy environment names remain supported by existing installations.
# T3CODE_CLERK_PUBLISHABLE_KEY=
# T3CODE_CLERK_JWT_TEMPLATE=
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=
# T3CODE_RELAY_URL=
# T3CODE_HOSTED_APP_URL=

# Optional signed macOS passkey builds.
# T3CODE_APPLE_TEAM_ID=
# T3CODE_MACOS_PROVISIONING_PROFILE=
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=
